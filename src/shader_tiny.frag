precision mediump float;uniform vec2 u_resolution,u_mouse;uniform float u_time;float h(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5);}float n(vec2 p){vec2 i=floor(p),f=fract(p);f*=f*(3.-2.*f);return mix(mix(h(i),h(i+vec2(1,0)),f.x),mix(h(i+vec2(0,1)),h(i+1.),f.x),f.y);}void main(){vec2 r=u_resolution,u=(gl_FragCoord.xy-.5*r)/r.y,m=u_mouse/r-.5;float t=u_time*(.4+2.*max(0.,1.-length(m)*2.)),v=n(u*3.+n(u*3.+t)*.8);vec3 c=mix(vec3(.05,.45,.98),vec3(.98,.15,.55),v);c=mix(c,vec3(1,.88,.1),v*v);for(int a=0;a<3;a++){float p=fract(t*.3+float(a)/3.),ro=.85*(1.-p),sc=.09*(1.-p)*smoothstep(0.,.1,p);for(int i=0;i<12;i++){float g=float(i)*.5236+p*.5;vec2 d=u-vec2(cos(g),sin(g))*ro;if(length(d)<sc){float nv=n(d/sc*2.5+t);c=mix(vec3(.08,.85,.35),vec3(1,.42,.05),nv);c=mix(c,vec3(1),smoothstep(.6,.9,nv));}}}gl_FragColor=vec4(c,1);}